PORT=3000

# RDS PostgreSQL endpoint (replace with your RDS endpoint)
DB_HOST=shopdb.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=shopdb
DB_USER=postgres
DB_PASSWORD=yourpassword

# ElastiCache Redis primary endpoint (replace with your ElastiCache endpoint)
REDIS_HOST=demo-redis.xxxxx.cache.amazonaws.com
REDIS_PORT=6379
CACHE_TTL=60
